# ==============================================================================
# SED Service Environment Template (Safe example values only — DO NOT put real secrets)
# ==============================================================================

COMPOSE_PROJECT_NAME=sed

# PostgreSQL (Docker Compose main service)
POSTGRES_DB=sed_db
POSTGRES_USER=sed_user
POSTGRES_PASSWORD=sed_dev_change_me_local_only
DATABASE_URL=postgres://sed_user:sed_dev_change_me_local_only@postgres:5432/sed_db?sslmode=disable

# API & Worker
API_PORT=8080
PROXY_PORT=8000
LOG_LEVEL=info
FILE_STORAGE_ROOT=/var/lib/sed/files
FILE_MAX_BYTES=52428800
URGENT_THRESHOLD_HOURS=16

# External Auth Integration
# Dev mode (docker-compose.dev-auth.yml): http://temp-auth:8091
# Production mode: https://orchestrator.example.local
AUTH_BASE_URL=http://temp-auth:8091

# External Platform & 1C Integration
# Dev mode (docker-compose.dev-mocks.yml): http://mock-external:8092
ORCH_BASE_URL=http://mock-external:8092
ONEC_BASE_URL=http://mock-external:8092/onec

# Isolated temp-auth settings (dev-only, separate compose override)
TEMP_AUTH_PORT=8091
TEMP_AUTH_SIGNING_KEY=dev_ephemeral_jwt_signing_key_change_in_prod
TEMP_AUTH_TOKEN_TTL_MIN=60

# Mock external service (dev-only)
MOCK_EXTERNAL_PORT=8092
MOCK_ONEC_FAIL_MODE=false
